<?xml version="1.0" encoding="utf-8"?>
<!--
  Contabilino - Configurazione degli artefatti per SignPath.
  Da incollare nel progetto Contabilino su SignPath (Artifact configurations).
  L'artifact caricato da GitHub Actions è uno zip che contiene Contabilino.exe;
  nome e versione del prodotto devono corrispondere a quelli scritti
  nell'eseguibile da strumenti/versione_exe.py (la versione arriva dal tag).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Contabilino.exe" product-name="Contabilino" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
